
#  ----------  HTTPS 统一入口  ----------
server {
    listen 443 ssl http2;
    server_name wx-api.xxx.com;

    # ① SSL 证书
    ssl_certificate     /etc/ssl/fullchain.pem;
    ssl_certificate_key /etc/ssl/privkey.pem;
    ssl_session_cache   shared:SSL:1m;
    ssl_session_timeout 10m;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5:!3DES;
    ssl_prefer_server_ciphers on;

    # ② 小程序验证文件（后台下载的 *.txt）
    location ~* \.txt$ {
        root /var/www/wx-verify/;
        add_header Content-Type text/plain;
        access_log off;
    }

    # ③ 普通业务接口
    location / {
        proxy_pass http://127.0.0.1:12001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # ④ WebSocket（WSS）（小程序 wx.connectSocket）
    location /wss {
        proxy_pass http://127.0.0.1:12003;   # 与 /ws 上游一致
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # 心跳超时按业务调
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # ⑤ 上传/下载（可选流式）
    location /file {
        proxy_pass http://127.0.0.1:12004;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # 大文件流式
        proxy_request_buffering off;
        proxy_buffering off;
        client_max_body_size 0;
    }
}


nginx重加载：nginx -s reload
nginx排查：tail -f /var/log/nginx/error.log